{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gabrielebaldassarre:author-pattern-consolidation:0.2",
  "title": "Author consolidation with independent rhetorical scope and relevance",
  "description": "Local v0.2 extension. All urn:0.1 references resolve only to the retained local schema, never the network.",
  "$ref": "#/$defs/FinalBundle",
  "$defs": {
    "Method": {
      "type": "object", "additionalProperties": false,
      "required": ["consolidation_version", "projection_version", "instructions_version", "schema_hash", "instructions_hash"],
      "properties": {
        "consolidation_version": { "const": "consolidate/2" },
        "projection_version": { "const": "observation-projection/1" },
        "instructions_version": { "const": "author-pattern-consolidator/0.2" },
        "schema_hash": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Hash" },
        "instructions_hash": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Hash" }
      }
    },
    "PatternScope": { "enum": ["rhetorical_strategy", "explanatory_device", "editorial_format", "local_content_pattern"] },
    "AuthorRelevance": { "enum": ["candidate", "uncertain", "unlikely"] },
    "RhetoricalId": { "type": "string", "pattern": "^APC::R[0-9]{4}$" },
    "CandidateRhetoricalGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["pattern_scope", "author_relevance", "label", "description", "abstraction_kind", "rationale", "variation_notes", "member_observation_ids"],
      "properties": {
        "pattern_scope": { "$ref": "#/$defs/PatternScope" },
        "author_relevance": { "$ref": "#/$defs/AuthorRelevance" },
        "label": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankLabel" },
        "description": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" },
        "abstraction_kind": { "enum": ["observed_regularities", "inferred_generalization"] },
        "rationale": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" },
        "variation_notes": { "type": "array", "maxItems": 12, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" } },
        "member_observation_ids": { "type": "array", "minItems": 2, "maxItems": 144, "uniqueItems": true, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/ObservationId" } }
      }
    },
    "CandidateRhetorical": {
      "type": "object", "additionalProperties": false, "required": ["groups", "unclustered_observations"],
      "properties": {
        "groups": { "type": "array", "maxItems": 144, "items": { "$ref": "#/$defs/CandidateRhetoricalGroup" } },
        "unclustered_observations": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/CandidateUnclusteredObservation" } }
      }
    },
    "CandidateNonsemantic": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/CandidateNonsemantic" },
    "CandidateSemantic": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/CandidateSemantic" },
    "AcceptedRhetoricalGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pattern_scope", "author_relevance", "label", "description", "abstraction_kind", "rationale", "variation_notes", "support", "observation_count", "article_count"],
      "properties": {
        "id": { "$ref": "#/$defs/RhetoricalId" },
        "pattern_scope": { "$ref": "#/$defs/PatternScope" },
        "author_relevance": { "$ref": "#/$defs/AuthorRelevance" },
        "label": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankLabel" },
        "description": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" },
        "abstraction_kind": { "enum": ["observed_regularities", "inferred_generalization"] },
        "rationale": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" },
        "variation_notes": { "type": "array", "maxItems": 12, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" } },
        "support": { "type": "array", "minItems": 2, "maxItems": 144, "uniqueItems": true, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/SupportEntry" } },
        "observation_count": { "type": "integer", "minimum": 2, "maximum": 144 },
        "article_count": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "AcceptedDimension": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "dimension", "corpus_hash", "input_hash", "method", "groups", "unclustered_observations"],
      "properties": {
        "schema_version": { "const": "author-pattern-dimension/0.2" },
        "dimension": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Dimension" },
        "corpus_hash": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Hash" },
        "input_hash": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Hash" },
        "method": { "$ref": "#/$defs/Method" },
        "groups": { "type": "array", "maxItems": 144 },
        "unclustered_observations": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/AcceptedUnclusteredObservation" } }
      },
      "allOf": [
        { "if": { "properties": { "dimension": { "const": "rhetorical" } } }, "then": { "properties": { "groups": { "type": "array", "items": { "$ref": "#/$defs/AcceptedRhetoricalGroup" } } } } },
        { "if": { "properties": { "dimension": { "const": "semantic" } } }, "then": { "properties": { "groups": { "type": "array", "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/AcceptedSemanticGroup" } } } } },
        { "if": { "properties": { "dimension": { "enum": ["epistemic", "decisional"] } } }, "then": { "properties": { "groups": { "type": "array", "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/AcceptedNonsemanticGroup" } } } } }
      ]
    },
    "PreparedDimension": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "schema_version", "corpus_hash", "input_hash", "method", "dimension", "observations"],
      "properties": {
        "status": { "const": "ready" },
        "schema_version": { "const": "author-pattern-preparation/0.2" },
        "corpus_hash": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Hash" },
        "input_hash": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Hash" },
        "method": { "$ref": "#/$defs/Method" },
        "dimension": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Dimension" },
        "observations": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/ProjectedObservation" } }
      }
    },
    "PrepareResult": { "oneOf": [{ "$ref": "#/$defs/PreparedDimension" }, { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/BlockedPreparation" }] },
    "FinalRhetoricalGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "dimension", "pattern_scope", "author_relevance", "label", "description", "abstraction_kind", "rationale", "variation_notes", "support", "observation_count", "article_count", "promotion_status", "review_status"],
      "properties": {
        "id": { "$ref": "#/$defs/RhetoricalId" }, "dimension": { "const": "rhetorical" },
        "pattern_scope": { "$ref": "#/$defs/PatternScope" }, "author_relevance": { "$ref": "#/$defs/AuthorRelevance" },
        "label": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankLabel" },
        "description": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" },
        "abstraction_kind": { "enum": ["observed_regularities", "inferred_generalization"] },
        "rationale": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" },
        "variation_notes": { "type": "array", "maxItems": 12, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/NonblankDescription" } },
        "support": { "type": "array", "minItems": 2, "maxItems": 144, "uniqueItems": true, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/SupportEntry" } },
        "observation_count": { "type": "integer", "minimum": 2, "maximum": 144 },
        "article_count": { "type": "integer", "minimum": 2, "maximum": 12 },
        "promotion_status": { "enum": ["cross_article_candidate", "recurrent_candidate"] }, "review_status": { "const": "unreviewed" }
      }
    },
    "AuthorPatternCandidates": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "corpus_hash", "method", "patterns", "editorial_format", "thematic", "rhetorical_groups", "unclustered_observations", "diagnostics"],
      "properties": {
        "schema_version": { "const": "author-pattern-candidates/0.2" },
        "corpus_hash": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Hash" }, "method": { "$ref": "#/$defs/Method" },
        "patterns": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/FinalNonsemanticGroup" } },
        "editorial_format": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/FinalNonsemanticGroup" } },
        "thematic": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/FinalNonsemanticGroup" } },
        "rhetorical_groups": { "type": "array", "maxItems": 144, "items": { "$ref": "#/$defs/FinalRhetoricalGroup" } },
        "unclustered_observations": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/FinalUnclusteredObservation" } },
        "diagnostics": { "type": "array", "maxItems": 100, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Diagnostic" } }
      }
    },
    "SemanticRecurrenceCandidates": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "corpus_hash", "method", "concepts", "relations", "unclustered_observations", "diagnostics"],
      "properties": {
        "schema_version": { "const": "semantic-recurrence-candidates/0.2" },
        "corpus_hash": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Hash" }, "method": { "$ref": "#/$defs/Method" },
        "concepts": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/FinalSemanticGroup" } },
        "relations": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/FinalSemanticGroup" } },
        "unclustered_observations": { "type": "array", "maxItems": 144, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/FinalUnclusteredObservation" } },
        "diagnostics": { "type": "array", "maxItems": 100, "items": { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Diagnostic" } }
      }
    },
    "DimensionMethods": {
      "type": "object", "additionalProperties": false, "required": ["rhetorical", "epistemic", "semantic", "decisional"],
      "properties": {
        "rhetorical": { "oneOf": [{ "$ref": "#/$defs/Method" }, { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Method" }] },
        "epistemic": { "oneOf": [{ "$ref": "#/$defs/Method" }, { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Method" }] },
        "semantic": { "oneOf": [{ "$ref": "#/$defs/Method" }, { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Method" }] },
        "decisional": { "oneOf": [{ "$ref": "#/$defs/Method" }, { "$ref": "urn:gabrielebaldassarre:author-pattern-consolidation:0.1#/$defs/Method" }] }
      }
    },
    "FinalBundle": {
      "type": "object", "additionalProperties": false, "required": ["author_patterns", "semantic_recurrences", "dimension_methods"],
      "properties": {
        "author_patterns": { "$ref": "#/$defs/AuthorPatternCandidates" }, "semantic_recurrences": { "$ref": "#/$defs/SemanticRecurrenceCandidates" },
        "dimension_methods": { "$ref": "#/$defs/DimensionMethods" }
      }
    }
  }
}
